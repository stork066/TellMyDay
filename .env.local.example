# Tell My Day — local environment template.
# Copy to .env.local and fill in. .env.local is gitignored.

# Microsoft Foundry project (https://ai.azure.com → your project → Overview).
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# OpenAI-compatible v1 endpoint of the same backing resource.
FOUNDRY_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
FOUNDRY_API_KEY=

# Model deployment name inside the Foundry project (e.g. gpt-4.1-mini).
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini

# Foundry agent that has the IQ knowledge base attached as an MCP tool.
FOUNDRY_AGENT_NAME=tell-my-day-agent

# Azure AI Search service backing the IQ knowledge base.
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_KB_NAME=tell-my-day-kb

# API version for the KB MCP endpoint + retrieve API (Foundry IQ preview).
FOUNDRY_IQ_API_VERSION=2026-05-01-preview
